<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root_compact"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notif_capsule"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Cyan Soundwave Icon -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_waveform_cyan" />

        <!-- Title + Elapsed Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.03"
                android:maxLines="1"
                android:text="CYBER_DRIVE.MP3"
                android:textColor="#9FEBF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_subtitle_compact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="00:00 / 04:00 • 128 BPM"
                android:textColor="#6B7F96"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5-Bar Floating Visualizer (Cyan, Green, LightCyan, Pink, Cyan) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/eq_c_1"
                android:layout_width="3.5dp"
                android:layout_height="12dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bar_eq_cyan" />

            <ImageView
                android:id="@+id/eq_c_2"
                android:layout_width="3.5dp"
                android:layout_height="18dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bar_eq_green" />

            <ImageView
                android:id="@+id/eq_c_3"
                android:layout_width="3.5dp"
                android:layout_height="9dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bar_eq_light_cyan" />

            <ImageView
                android:id="@+id/eq_c_4"
                android:layout_width="3.5dp"
                android:layout_height="15dp"
                android:layout_marginEnd="2dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bar_eq_pink" />

            <ImageView
                android:id="@+id/eq_c_5"
                android:layout_width="3.5dp"
                android:layout_height="8dp"
                android:contentDescription="@null"
                android:scaleType="fitXY"
                android:src="@drawable/bar_eq_cyan" />
        </LinearLayout>

        <!-- Prev Button -->
        <FrameLayout
            android:id="@+id/btn_prev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_btn_dark">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_prev_cyan" />
        </FrameLayout>

        <!-- Cyan Pill Play / Pause Button -->
        <LinearLayout
            android:id="@+id/btn_play_pause"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:background="@drawable/bg_pill_btn_cyan"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/icon_play_pause"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_pause_dark" />

            <TextView
                android:id="@+id/label_play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="monospace"
                android:text="PAUSE"
                android:textColor="#06131A"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Next Button -->
        <FrameLayout
            android:id="@+id/btn_next"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_btn_dark">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_skip_next_cyan" />
        </FrameLayout>
    </LinearLayout>

    <!-- Thin Live Progress Strip -->
    <ProgressBar
        android:id="@+id/notif_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="7dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_pill_progress" />
</LinearLayout>
